# === Supabase ===
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings → API → service_role (server only, keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Anthropic (Claude) ===
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Answer model. haiku = cheap/fast for a public demo.
ANTHROPIC_MODEL=claude-haiku-4-5

# === Voyage AI (embeddings) ===
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3

# === Cloudflare Turnstile (captcha) ===
# Public site key from the Cloudflare dashboard (the secret key goes in Supabase
# → Auth → Attack Protection → CAPTCHA). If unset, the app signs in without a
# captcha (only works when Supabase captcha protection is OFF).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
